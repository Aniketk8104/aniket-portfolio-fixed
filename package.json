{
  "name": "aniket-portfolio-fix",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "node scripts/validate-content.mjs && node scripts/generate-sitemap.mjs && node scripts/check-tokens.mjs",
    "build": "vite build",
    "postbuild": "node scripts/check-freelance-strings.mjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "check:tokens": "node scripts/check-tokens.mjs",
    "check:lighthouse": "npm run build && start-server-and-test preview http://127.0.0.1:4173 \"lighthouse http://127.0.0.1:4173 --only-categories=performance,accessibility,best-practices,seo --screen emulated-desktop --output html --output-path ./lighthouse-report.html --chrome-flags=\\\"--headless --no-sandbox\\\"\""
  },
  "dependencies": {
    "@fontsource/inter": "^5.2.8",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@react-three/drei": "^9.96.5",
    "@react-three/fiber": "^8.15.16",
    "framer-motion": "^11.0.3",
    "gsap": "^3.12.5",
    "lenis": "1.3.25",
    "lottie-react": "^2.4.0",
    "particles.js": "^2.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-helmet-async": "^2.0.4",
    "react-intersection-observer": "^9.8.1",
    "react-parallax-tilt": "^1.7.207",
    "react-router-dom": "^6.30.4",
    "three": "^0.161.0",
    "web-vitals": "^3.5.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^25.9.1",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/react-router-dom": "^5.3.3",
    "@typescript-eslint/eslint-plugin": "^8.60.0",
    "@typescript-eslint/parser": "^8.60.0",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "^4.1.8",
    "eslint": "^8.57.0",
    "eslint-plugin-react": "^7.35.0",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-react-refresh": "^0.4.9",
    "fast-check": "^4.8.0",
    "globals": "^13.24.0",
    "jsdom": "^29.1.1",
    "lighthouse": "^12.8.2",
    "start-server-and-test": "^2.0.3",
    "terser": "^5.48.0",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3",
    "vite": "^5.3.4",
    "vitest": "^4.1.8"
  }
}
