{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/case-studies/radique",
      "destination": "/case-studies/radioque",
      "permanent": true
    },
    {
      "source": "/case-studies/labour-link",
      "destination": "/case-studies/future-fortune-hrms",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
